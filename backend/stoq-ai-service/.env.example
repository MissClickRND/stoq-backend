NODE_ENV=development
HOST=127.0.0.1
PORT=3006
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://admin:admin@localhost:5672
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_PDF_ENGINE=native
# HTTP/HTTPS proxy only for OpenRouter. Happ on this PC: http://127.0.0.1:10809.
# Empty for direct access. TUN is not required.
AI_PROXY_URL=http://127.0.0.1:10809
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_OUTPUT_TOKENS=16000
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=40000000
MAX_CONCURRENT_RECOGNITIONS=2
# Optional: require this header on POST /api/v1/upd/recognize.
SERVICE_API_KEY=
