generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  created
  pending_reservation
  confirmed
  rejected
  cancelled
  completed
}

model Order {
  id          Int      @id @default(autoincrement())
  status      OrderStatus @default(created)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  items       OrderItem[]

}

model OrderItem {
  id        Int  @id @default(autoincrement())
  orderId  Int
  dishId   Int  
  quantity  Int     

  order     Order   @relation(fields: [orderId], references: [id])

}