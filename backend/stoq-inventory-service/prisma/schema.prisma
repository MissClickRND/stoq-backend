generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["inventory", "supply"]
}

model Supply {
  restaurantId Int?

  id           Int          @id @default(autoincrement())
  supplyNumber String        @map("supply_number")
  supplier     String?
  totalPrice   Decimal?     @map("total_price") @db.Decimal(18, 2)
  status       SupplyStatus @default(RECEIVED)
  receivedAt   DateTime     @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  items        SupplyItem[]

  @@map("supplies")
  @@schema("supply")
  @@index([restaurantId])
  @@unique([restaurantId, supplyNumber])
}

model SupplyItem {
  id            Int      @id @default(autoincrement())
  supplyId      Int      @map("supply_id")
  productId     Int      @map("product_id")
  quantity      Decimal  @db.Decimal
  totalPrice    Decimal? @map("total_price") @db.Decimal(18, 2)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  supply        Supply   @relation(fields: [supplyId], references: [id])

  @@index([supplyId])
  @@map("supply_items")
  @@schema("supply")
}

model Batch {
  restaurantId Int?

  id              Int           @id @default(autoincrement())
  supplyId        Int           @map("supply_id")
  productId       Int           @map("product_id")
  initialQuantity Decimal       @map("initial_quantity") @db.Decimal
  disposedAt      DateTime?     @map("disposed_at") @db.Timestamptz(6)
  price           Decimal?      @db.Decimal(18, 6)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  status          BatchStatus   @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  balance         BatchBalance?

  @@index([supplyId])
  @@index([productId])
  @@index([status, expiresAt])
  @@map("batches")
  @@schema("inventory")

  @@index([restaurantId])
}

model BatchBalance {
  batchId           Int      @id @map("batch_id")
  availableQuantity Decimal  @default(0) @map("available_quantity") @db.Decimal
  reservedQuantity  Decimal  @default(0) @map("reserved_quantity") @db.Decimal
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  batch             Batch    @relation(fields: [batchId], references: [id])

  @@map("batch_balances")
  @@schema("inventory")
}


model StockMovement {
  restaurantId Int?
  actorId Int?
  actorName String?
  actorRole String?

  id        Int      @id @default(autoincrement())
  orderId   String   @map("order_id")
  batchId   Int      @map("batch_id")
  productId Int      @map("product_id")
  quantity  Decimal  @db.Decimal // Отрицательное для списания, положительное для оприходования
  type      String   // Например: 'DEDUCTION', 'RECEIPT'
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stock_movements")
  @@schema("inventory")
  @@index([restaurantId])
}

model IdempotencyKey {
  restaurantId Int?

  key       String   @id
  orderId   String   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
  @@schema("inventory")
  @@index([restaurantId])
}

enum SupplyStatus {
  RECEIVED
  CANCELLED
  IN_TRANSIT

  @@schema("supply")
}

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  RUNNINGOUT

  @@schema("inventory")
}
