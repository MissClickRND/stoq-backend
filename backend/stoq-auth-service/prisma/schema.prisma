generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  STOREKEEPER
  WAIT_CONFIRM
}

model User {
  id                 Int        @id @default(autoincrement())
  restaurantId       Int
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])

  fullName           String
  email              String     @unique
  passwordHash       String
  hashedRefreshToken String?
  tokenVersion       Int        @default(0)
  blocked            Boolean    @default(false)
  role               Role

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String?
  email     String?
  isDemo    Boolean  @default(false)
  demoReady Boolean  @default(false)

  users     User[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id           String     @id @default(uuid())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  role         Role
  expiresAt    DateTime
  revokedAt    DateTime?
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}
