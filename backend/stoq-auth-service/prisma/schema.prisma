generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  STOREKEEPER
  WAIT_CONFIRM
}

model User {
  id                 Int        @id @default(autoincrement())
  restaurantId       Int
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])

  fullName           String
  email              String     @unique
  passwordHash       String
  telegramSessions   TelegramSession[]
  hashedRefreshToken String?
  tokenVersion       Int        @default(0)
  blocked            Boolean    @default(false)
  role               Role

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String?
  email     String?
  isDemo    Boolean  @default(false)
  demoReady Boolean  @default(false)

  users     User[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id           String     @id @default(uuid())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  role         Role
  expiresAt    DateTime
  revokedAt    DateTime?
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model ActivityLog {
  id String @id
  stockMovementId Int?
  restaurantId Int
  authorId Int?
  authorName String
  authorRole String
  action String
  category String
  title String
  description String
  object String?
  detail String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([restaurantId, createdAt, id])
  @@unique([restaurantId, stockMovementId])
}

model ActivitySyncState {
  restaurantId Int @id
  stockMovementId Int @default(0)
}

model TelegramSession {
  telegramUserId String @id @db.VarChar(20)
  tokenDigest String @unique @db.Char(64)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId Int
  tokenVersion Int
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
}
