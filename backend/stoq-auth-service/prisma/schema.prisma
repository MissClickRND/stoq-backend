generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  STOREKEEPER
  WAIT_CONFIRM
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String
  hashedRefreshToken String?
  tokenVersion       Int      @default(0)
  role               Role     
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
