PORT=3000
RABBITMQ_URL=amqp://admin:admin@localhost:5672
AI_RPC_TIMEOUT_MS=150000
AI_MAX_FILE_SIZE_MB=20
AUTH_RPC_TIMEOUT_MS=10000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set true in both gateway and auth to allow demo creation/listing/login in production.
# This flag does not enable destructive /test/reset operations.
ENABLE_DEMO_RESTAURANTS=false
# Legacy flag also enables destructive test tools; leave false in production.
ENABLE_TEST_TOOLS=false
